<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚀 Intents implícitos"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 1. MAPAS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="1️⃣ Google Maps (geo:)"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDireccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Dirección o lugar (ej: Torre Entel Santiago)"
            android:inputType="textPostalAddress" />

        <Button
            android:id="@+id/btnMapaTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗺️ BUSCAR EN EL MAPA" />

        <!-- 2. WEB -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="2️⃣ Página web (https://)"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="www.santotomas.cl"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnWeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 ABRIR PÁGINA" />

        <!-- 3. LLAMAR -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="3️⃣ Marcador telefónico (tel:)"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="+56912345678"
            android:inputType="phone" />

        <Button
            android:id="@+id/btnLlamar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📞 ABRIR MARCADOR" />

        <!-- 4. CORREO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="4️⃣ Correo (mailto:)"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Destinatario"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/etAsunto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Asunto"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/etCuerpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cuerpo del mensaje"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <Button
            android:id="@+id/btnCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📧 REDACTAR CORREO" />

        <!-- 5. SMS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="5️⃣ SMS (smsto:)"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etSmsNumero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Número de destino"
            android:inputType="phone" />

        <EditText
            android:id="@+id/etSmsTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Texto del mensaje"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <Button
            android:id="@+id/btnSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💬 PREPARAR SMS" />

        <Button
            android:id="@+id/btnVolverImpl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="VOLVER" />
    </LinearLayout>
</ScrollView>
